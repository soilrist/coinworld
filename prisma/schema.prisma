// Damifarm 통합 운영 DB 스키마
// 개발/데모 환경: SQLite (파일 기반, 별도 서버 불필요)
// 운영 전환: datasource의 provider를 "postgresql"로, url을 DATABASE_URL(Postgres)로 교체하면
// 아래 스키마는 대부분 그대로 사용 가능 (SQLite 전용 타입 없음).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 상품 / 재고
// ---------------------------------------------------------------------------
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  variety     String // 품종 (예: 베니하루카)
  weightLabel String // 표시용 중량 (예: 5kg)
  weightGrams Int
  price       Int // 원 단위
  compareAt   Int? // 할인 전 가격(있는 경우)
  shippingFee Int      @default(0)
  stock       Int      @default(0)
  lowStockAt  Int      @default(10)
  isPublished Boolean  @default(true)
  isSoldOut   Boolean  @default(false)
  sortOrder   Int      @default(0)
  shortDescription String @default("")
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  stockLogs  InventoryLog[]
}

model InventoryLog {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  change    Int // +입고 / -출고(음수)
  reason    String // "입고" | "판매" | "조정" | "반품"
  memo      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 고객
// ---------------------------------------------------------------------------
model Customer {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  email         String?
  address       String?
  addressDetail String?
  memo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders    UnifiedOrder[]
  inquiries Inquiry[]
}

// ---------------------------------------------------------------------------
// 통합 주문 (자체몰 / 스마트스토어 / 전화주문 / 향후 채널 공통 모델)
// ---------------------------------------------------------------------------
enum OrderChannel {
  WEB
  SMARTSTORE
  PHONE
  COUPANG
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model UnifiedOrder {
  id               String   @id @default(cuid())
  channel          OrderChannel @default(WEB)
  externalOrderId  String? // 스마트스토어 등 외부 채널 주문번호
  customer         Customer @relation(fields: [customerId], references: [id])
  customerId       String
  recipientName    String
  recipientPhone   String
  address          String
  addressDetail    String?
  deliveryMemo     String?

  itemsAmount      Int
  shippingAmount   Int
  discountAmount   Int      @default(0)
  totalAmount      Int

  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus @default(PENDING)
  paymentMethod    String? // "card" | "bank_transfer" | "naverpay" | "kakaopay" | "mock"
  paymentProvider  String   @default("mock")

  trackingCarrier  String?
  trackingNumber   String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([channel])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     UnifiedOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  nameSnapshot String
  weightLabelSnapshot String
  unitPrice Int
  quantity  Int
}

// ---------------------------------------------------------------------------
// 문의 (홈페이지 / 스마트스토어 / 전화 메모 통합)
// ---------------------------------------------------------------------------
enum InquiryChannel {
  WEB
  SMARTSTORE
  PHONE
}

enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Inquiry {
  id         String   @id @default(cuid())
  channel    InquiryChannel @default(WEB)
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  name       String
  phone      String?
  title      String
  message    String
  answer     String?
  status     InquiryStatus @default(OPEN)
  createdAt  DateTime @default(now())
  answeredAt DateTime?
}

// ---------------------------------------------------------------------------
// 리뷰 (실제 데이터 유입 전까지 비어 있는 것이 정상 — 가짜 리뷰 생성 금지)
// ---------------------------------------------------------------------------
model Review {
  id        String   @id @default(cuid())
  productId String
  authorName String
  rating    Int // 1-5
  content   String
  hasPhoto  Boolean  @default(false)
  photoUrl  String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 관리자 계정 / 보안
// ---------------------------------------------------------------------------
model AdminUser {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            String   @default("admin") // "admin" | "staff"
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  failedLoginCount Int     @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime @default(now())

  auditLogs AuditLog[]
  loginLogs LoginLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  action    String // "ORDER_REFUND" | "PRICE_CHANGE" | "CUSTOMER_DELETE" ...
  target    String // 대상 리소스 식별자
  detail    String?
  requiresApproval Boolean @default(false)
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  adminId   String?
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 저널 (농장 이야기 / SEO 블로그)
// ---------------------------------------------------------------------------
model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String // "수확" | "밭관리" | "출하소식" | "방송" | "수상" | "공지"
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
}
