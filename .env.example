# ── 데이터베이스 ─────────────────────────────────────────────
# 개발/데모: SQLite 파일 기반. 운영 전환 시 prisma/schema.prisma의
# datasource provider를 "postgresql"로 바꾸고 아래 URL을 Postgres 접속 문자열로 교체.
DATABASE_URL="file:./dev.db"

# ── 사이트 ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 관리자 인증 ──────────────────────────────────────────────
# 세션(JWT) 서명 비밀키. 32자 이상의 무작위 문자열로 반드시 교체할 것.
# 생성 예: openssl rand -base64 32
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# 최초 관리자 계정 (prisma/seed.ts 실행 시 1회 생성됨). 최초 로그인 후 반드시 변경할 것.
ADMIN_EMAIL="admin@damifarm.kr"
ADMIN_INITIAL_PASSWORD="ChangeMe!2026"

# ── 네이버 커머스API (스마트스토어 연동, 선택) ───────────────────
# 비워두면 통합은 비활성 상태로 유지되며 앱 동작에는 영향 없음.
NAVER_COMMERCE_CLIENT_ID=""
NAVER_COMMERCE_CLIENT_SECRET=""
